                "location": "535, 5th Ave, 18th floor, New York, NY 10017, USA",
                // "contact": "+1 212 201 0755",
                "mail_id": "jewelry@hk.co"
            },
            {
                "id": '438',
                "company_name": "H. K. Designs Inc.",
                "location": "386 Pennsylvania Ave. Suite#2SW Glen Ellyn, Illinois 60137",
                "contact": "+1 212 201 0755",
                "mail_id": "jewelry@hk.co"
            }
        ];

        var filterId = globalAddress.map(function(a) {
            return a.id;
        });
        var popupTxtBlock = $(".popup-txt-block");


        function popTemplate(number_addresss) {
            return `<div id="pop-${number_addresss.id}" class="pop-info">
                            <div class="c_name">${number_addresss.company_name}</div>
                            <div class="popup-txt-flex ${number_addresss.location ? '' : 'hide'}">
                                <div class="icn-block">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="10.426" height="15.06"
                                        viewBox="0 0 10.426 15.06">
