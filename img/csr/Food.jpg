<script>
  var deviceWidth = window.innerWidth;
  var deviceHeight = window.innerHeight;

  if (deviceWidth > 767 && deviceWidth > deviceHeight) {
    //for landscape devices
    var scriptToLoad = "dist/js/desktop-only-app.min.js";
  } else {
    //for portrait devices
    var scriptToLoad = "dist/js/app.min.js";
  }
  var dynamicScript = document.createElement("script");
  dynamicScript.setAttribute("src", scriptToLoad);
  document.body.appendChild(dynamicScript);

  //madeByTing script
  var template = document.createElement("template");
  template.innerHTML = `
    <style>
