    <script>
    dynamicScript.addEventListener("load", function(event) {
        $("#thankyou").hide();
        var sc = $(window).scrollTop()
        if (sc > 150) {
            $("#main-navbar").addClass("navbar-scroll")
        } else {
            $("#main-navbar").removeClass("navbar-scroll")
        }

        $("#collaborate-form").validate({
            submitHandler: function(form) {
                $.ajax({
                    url: 'https://script.google.com/macros/s/AKfycbyLMxqig-97V2_ZXYSbeq0Z7LyTAwhZD0VUSaxyRCbPhseNW5HQk4bycdzwjwC60qb_5g/exec',
                    type: 'post',
                    data: $("#collaborate-form").serializeArray(),
                    success: function($response) {
                        $('#thankyou').show();
                        $('body').css({
                            "overflow": "hidden",
                            "position": "relative"
                        });
                        $('#collaborate-form')[0].reset();
                        setTimeout(function() {
                            $('#thankyou').hide();
                            $('body').css({
                                "overflow": "unset",
                                "position": "unset"
                            });
                        }, 5000);
                    },
                    error: function() {
                        alert("There was an error. PLease try again.")
                    }
                });
            }
        });
        $("img.close").click(function() {
            $("#thankyou").hide();
        });
        $(".mat-input").focus(function() {
            $(this).parent().addClass("is-active is-completed");
        });

        $(".mat-input").focusout(function() {
            if ($(this).val() === "")
                $(this).parent().removeClass("is-completed");
            $(this).parent().removeClass("is-active");
        })

        if ($(window).outerWidth() < 992) {
            $("#slider1").slick({
                autoplay: true,
                speed: 1000,
                autoplaySpeed: 2000,
                slidesToShow: 1,
                arrows: true,
                dots: true
            });
        }

        $("#awards-sec-slider").slick({
            autoplay: true,
            speed: 1000,
            variableWidth: true,
            arrows: true,
            prevArrow: '<img src="img/slide-arrow.png" class="arrow prv" alt="">',
            nextArrow: '<img src="img/slide-arrow.png" class="arrow nxt" alt="">',
        });

        $(".banner_slider").slick({
            autoplay: true,
            speed: 3000,
            autoplaySpeed: 3000,
            arrows: true,
            dots: false,
            prevArrow: '<img src="img/slide-arrow.png" class="arrow prv" alt="">',
            nextArrow: '<img src="img/slide-arrow.png" class="arrow nxt" alt="">',
        });

        $("#client-logo-slider").slick({
            autoplay: true,
            speed: 1000,
            slidesToShow: 5,
            arrows: true,
            prevArrow: '<img src="img/slide-arrow.png" class="arrow prv" alt="">',
            nextArrow: '<img src="img/slide-arrow.png" class="arrow nxt" alt="">',
            responsive: [{
                breakpoint: 768,
                settings: {
                    slidesToShow: 1,
                    dots: false,
                },
            }, ],
        });

        $("#certification_logo").slick({
            autoplay: true,
            speed: 1000,
            autoplaySpeed: 2000,
            slidesToShow: 5,
            arrows: true,
            prevArrow: '<img src="img/slide-arrow.png" class="arrow prv" alt="">',
            nextArrow: '<img src="img/slide-arrow.png" class="arrow nxt" alt="">',
            responsive: [{
                    breakpoint: 1199,
                    settings: {
                        slidesToShow: 4,
                        dots: false,
                    },
                },
                {
                    breakpoint: 991,
                    settings: {
                        slidesToShow: 3,
                        dots: false,
                    },
                },
                {
                    breakpoint: 767,
                    settings: {
                        slidesToShow: 1,
                        dots: false,
                    },
                },
            ],
        });

        $("#team-slider").slick({
            autoplay: true,
            speed: 1000,
            variableWidth: true,
            dots: true,
            responsive: [{
                    breakpoint: 992,
                    settings: {
                        slidesToShow: 2,
                        slidesToScroll: 1,
                        variableWidth: false,
                    },
                },
                {
                    breakpoint: 767,
                    settings: {
                        slidesToShow: 1,
                        slidesToScroll: 1,
                        variableWidth: false,
                    },
                },
            ],
        });


        $("#testimonial_slider").slick({
            // autoplay: true,
            dots: true,
            centerMode: true,
            variableWidth: true,
            // speed: 1000,
            // autoplaySpeed: 2000,
            // slidesToShow: 3,
            arrows: false,
            responsive: [{
                    breakpoint: 1199,
                    settings: {
                        slidesToShow: 4,
                    },
                },
                {
                    breakpoint: 991,
                    settings: {
                        slidesToShow: 1,
                    },
                },
                {
                    breakpoint: 0,
                    settings: {
                        slidesToShow: 1,
                    },
                },
            ],
        });


        // this data for hover addrsss
        var globalAddress = [{
                "id": '435',
                "company_name": "H. K. Designs (India) LLP.",
                "location": "Unit No. 113, SDF-4, SEEPZ-SEZ, Andheri (East), Mumbai - 400096, Maharashtra, India.",
