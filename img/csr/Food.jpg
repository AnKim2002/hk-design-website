                                            transform="translate(-7.875 -3.375)" fill="#293896" />
                                    </svg>
                                </div>
                                <div class="txt-block">${number_addresss.location}</div>
                            </div>
                            <div class="popup-txt-flex ${number_addresss.mail_id ? '' : 'hide'}">
                                <div class="icn-block">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="15.241" height="9.907" viewBox="0 0 15.241 9.907">
                                        <path id="Path_384" data-name="Path 384" d="M127.141,134.4a1.133,1.133,0,0,0-.607.179l6.525,5.7a.791.791,0,0,0,1.107,0l6.537-5.7a1.139,1.139,0,0,0-.607-.173H127.141Zm-1.078.774a1.138,1.138,0,0,0-.066.369v7.621a1.141,1.141,0,0,0,1.143,1.143H140.1a1.141,1.141,0,0,0,1.143-1.143v-7.621a1.14,1.14,0,0,0-.066-.369l-6.507,5.68a1.6,1.6,0,0,1-2.108-.006Z" transform="translate(-125.998 -134.4)" fill="#293896"/>
                                    </svg>


                                </div>
                                <div class="txt-block">${number_addresss.mail_id}</div>
                            </div>
                            <div class="popup-txt-flex ${number_addresss.contact ? '' : 'hide'}">
                                <div class="icn-block">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="12.66" height="12.66"
                                        viewBox="0 0 12.66 12.66">
                                        <path id="Icon_awesome-phone-alt" data-name="Icon awesome-phone-alt"
                                            d="M12.3,8.946,9.529,7.759a.593.593,0,0,0-.692.171l-1.226,1.5A9.165,9.165,0,0,1,3.229,5.047l1.5-1.226A.592.592,0,0,0,4.9,3.128L3.711.359a.6.6,0,0,0-.68-.344L.46.609A.593.593,0,0,0,0,1.187,11.472,11.472,0,0,0,11.473,12.66a.593.593,0,0,0,.579-.46l.593-2.572A.6.6,0,0,0,12.3,8.946Z"
                                            transform="translate(0 0)" fill="#293896" />
                                    </svg>

                                </div>
                                <div class="txt-block">${number_addresss.contact}</div>
                            </div>
                        </div>`;
        }
        globalAddress.map((address) => {
            $(popupTxtBlock).append(popTemplate(address));
            // if(){}
        });

        var commonClass = document.querySelectorAll(".hove");
        // Report the centre of the group in "screen coordinates"
        var commonClassArray = Array.from(commonClass)
        $(commonClassArray).each(function(i, val) {

            var bbox = val.getBBox();
            var ctm = val.getCTM()
            // Calculate the centre of the group
            var cx = bbox.x + bbox.width / 2;
            var cy = bbox.y + bbox.height / 2;

            // Report the centre of the group in "group coordinates"
            // alert("centre (group coords) = ( " + cx + ", " + cy + " )");

            // Transform cx,cy by the groups transform
            var pt = document.getElementById("global-map").createSVGPoint();
            pt.x = cx;
            pt.y = cy;
            pt = pt.matrixTransform(ctm);

            var EachClass = $(val).attr("class", "hove")
            if ($(window).outerWidth() > 992) {
                var val2 = $(val).attr("id").split('Group_')[1];
                $(".pop-info").slice(1).hide();
                console.log(val2, "hove me")
            }

            EachClass.mouseover(function() {

                $(".popup-txt-block").css({
                    "top": pt.y,
                    "left": pt.x + 20,
                    "bottom": "unset",
                    "right": "unset",
                    "display": "block"
                });
                $(".pop-info").hide();
                $("#pop-" + val2).show();

            });
            EachClass.mouseout(function() {
                $(".popup-txt-block").css({
                    "display": "none"
                });
                $(".pop-info").hide()
            });
        });
        close
    })

    window.addEventListener("load", function() {
        setTimeout(
            function open(event) {
                document.querySelector(".home_page_popup").style.display = "block";
            },
            2000
        )
    });


    document.querySelector("#close").addEventListener("click", function() {
        document.querySelector(".home_page_popup").style.display = "none";
    });
    </script>

</body>

</html>